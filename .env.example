# AegisVeto Environment Configuration Baseline

PORT=3000
NODE_ENV=development

# Layer 2 AI Provider Selection ('ollama' or 'groq')
LLM_PROVIDER=ollama

# Ollama (Local / Air-Gapped)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Groq (Cloud LPUs)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Vault Credential Mapping Prefix: AEGIS_VAULT_<REF>
# AEGIS_VAULT_GITHUB_TOKEN=ghp_example_token
# AEGIS_VAULT_SLACK_WEBHOOK=https://hooks.slack.com/services/...

# Outbound Alert Webhook (Slack / Discord / Generic JSON)
# AEGIS_WEBHOOK_URL=https://hooks.slack.com/services/...
